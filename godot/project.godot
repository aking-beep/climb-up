; CLIMB UP: Godot prototype. See docs/godot-migration/architecture.md.
config_version=5

[application]

config/name="CLIMB UP"
config/description="A mountaineering adventure. How high you climb isn't how you win."
run/main_scene="res://modes/expedition/menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

Settings="*res://core/settings/settings.gd"
GameInput="*res://core/input/game_input.gd"
Audio="*res://core/audio/audio.gd"
Expedition="*res://modes/expedition/expedition.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=980.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.09, 1)
