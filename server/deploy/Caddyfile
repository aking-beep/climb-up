# HTTPS for the records service. Caddy gets and renews the certificate.
{$RECORDS_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	request_body {
		max_size 256KB
	}
	# The privacy policy (the game and the store listing link here).
	handle /privacy {
		root * /srv/site
		rewrite * /privacy.html
		file_server
	}
	# Everything else is the service. No access log here: the service logs
	# each request without addresses (the privacy policy says so).
	handle {
		reverse_proxy records:8080
	}
}
